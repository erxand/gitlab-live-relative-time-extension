{
  "manifest_version": 3,
  "name": "GitLab Live Relative Time",
  "description": "Keeps GitLab's relative timestamps (\"just now\", \"3 hours ago\") accurate instead of frozen at page load.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "gitlab-live-relative-time@xanderhunt.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gitlab.com/*"
      ],
      "js": [
        "relative-time.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
